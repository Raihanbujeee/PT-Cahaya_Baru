# Dependency lokal tidak perlu di-upload.
# Runtime vercel-php akan menjalankan `composer install` sendiri saat build.
/vendor

/node_modules

# File environment lokal (jangan pernah ikut ter-deploy).
/.env
/.env.*
!/.env.example

# Tidak dipakai saat runtime.
/tests
/diagrams
/storage

# Sisa build/dev lokal.
/public/build
/public/hot
/public/storage

# Git & tooling.
/.git
/.github
/.idea
/.vscode
/.fleet
/.zed
/auth.json
*.log
