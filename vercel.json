{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "framework": null,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4"
        }
    },
    "installCommand": "",
    "buildCommand": "echo skip",
    "outputDirectory": "public",
    "routes": [
        {
            "src": "/",
            "dest": "/api/index.php"
        },
        {
            "src": "/index\\.php",
            "dest": "/api/index.php"
        },
        {
            "src": "/\\.htaccess",
            "dest": "/api/index.php"
        },
        {
            "src": "^/(\\.git|\\.env|app|bootstrap|config|database|lang|node_modules|public|resources|routes|tests|vendor|storage|artisan|composer\\.json|composer\\.lock|package\\.json|package-lock\\.json|phpunit\\.xml|vite\\.config\\.js|DEPLOY-VERCEL\\.md|README\\.md|api)(/|$|\\.)",
            "dest": "/api/index.php"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
